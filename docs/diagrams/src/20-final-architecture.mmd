    chunk["Chunk: structure-aware, 256 tokens<br/>7,411 chunks"]:::ingest
    embed["Embed: bge-small-en-v1.5<br/>384-d, local"]:::ingest
    pg[("Postgres 16<br/>pgvector HNSW · full-text tsvector<br/>llm_cache · request_log")]:::store
