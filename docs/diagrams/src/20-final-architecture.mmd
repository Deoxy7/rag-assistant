    pdf -->|"bytes"| parse
    parse -->|"blocks + offsets"| chunk
    chunk -->|"chunks"| embed
    embed -->|"vectors + text"| pg
    ui -->|"question, filters"| api
    api -->|"query"| hybrid
    pg -.->|"nearest vectors, matching words"| hybrid
    hybrid -->|"fused top 10"| rerank
    rerank -->|"10 chunks, reranked"| guard
    guard -->|"fenced sources"| llm
    llm -->|"tokens"| cite
    cite -->|"SSE: sources, deltas, answer"| api
    evalh -->|"same pipeline, scored"| hybrid
