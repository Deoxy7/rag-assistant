    text[("canonical text<br/>10 filings")]:::store
    find["scripts/find_quote.py<br/>search the text, not the retriever"]:::evalc
    write["write question + reference answer<br/>+ exact quote(s)"]:::evalc
    mix["type mix<br/>22 factual · 13 table · 8 exact-token ·<br/>9 multi-hop · 9 unanswerable"]:::io
    neg["unanswerable: check absence<br/>by full-text search"]:::evalc
    audit["label audit: answer figures elsewhere<br/>in the filing → 8 questions gain alternatives"]:::evalc
    golden["golden_v1.jsonl<br/>sha256 recorded in every result"]:::io
