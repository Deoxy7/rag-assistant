# Template for .env. `make up` copies this to .env if .env does not exist yet.
# Both docker compose (to create the database) and app/config.py (to connect to it)
# read the same .env, so the two can never disagree.
#
# These are LOCAL DEVELOPMENT values only. The database listens on 127.0.0.1,
# so nothing outside this machine can reach it. Never reuse them anywhere real.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev_only

# --- LLM: generation + eval judge (any OpenAI-compatible Chat Completions endpoint) ---
# Gemini via its OpenAI-compatible endpoint. To switch provider, change these lines only:
#   OpenAI:  LLM_PROVIDER=openai, LLM_BASE_URL= (empty = OpenAI's default), OPENAI_API_KEY=…, models gpt-…
#   Offline: LLM_PROVIDER=fake (deterministic extractive stand-in; never used silently)
# Keys are secrets: never commit .env. Billed per token on paid tiers; Gemini also has a free tier.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Pick names from your key's own model list (docs/13 §5); pinned names, not *-latest aliases.
LLM_MODEL=gemini-3.5-flash
LLM_JUDGE_MODEL=gemini-3.5-flash-lite
# Gemini 3.x Flash counts its hidden thinking tokens against the output cap.
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=low
# Retries on 429 (except an empty balance) and 5xx, exponential backoff with jitter.
LLM_MAX_RETRIES=6
# Only needed when LLM_PROVIDER=openai:
OPENAI_API_KEY=
