# Template for .env. `make up` copies this to .env if .env does not exist yet.
# Both docker compose (to create the database) and app/config.py (to connect to it)
# read the same .env, so the two can never disagree.
#
# These are LOCAL DEVELOPMENT values only. The database listens on 127.0.0.1,
# so nothing outside this machine can reach it. Never reuse them anywhere real.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev_only

# --- LLM: generator + eval judge (any OpenAI-compatible Chat Completions endpoint) ---
# The generator and the judge have separate settings so the judge can be a different model family
# (see README "Models"). Defaults: both on Groq's free tier, generator Qwen, judge gpt-oss.
# Switching provider = edit these lines. Examples:
#   Gemini:  LLM_PROVIDER=gemini, LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/,
#            LLM_MODEL=gemini-3.5-flash-lite, GEMINI_API_KEY=…
#   OpenAI:  LLM_PROVIDER=openai, LLM_BASE_URL= (empty = OpenAI's default), OPENAI_API_KEY=…, models gpt-…
#   Offline: LLM_PROVIDER=fake (deterministic extractive stand-in; never used silently)
# Keys are secrets: never commit .env. Pick model names from your key's own models.list();
# pin exact names, not *-latest aliases.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=
LLM_JUDGE_PROVIDER=groq
LLM_JUDGE_BASE_URL=https://api.groq.com/openai/v1
LLM_JUDGE_MODEL=openai/gpt-oss-120b
LLM_JUDGE_REASONING_EFFORT=low
# Retries on 429 rate limits and 5xx with exponential backoff; daily quotas and HTTP 402 fail fast.
LLM_MAX_RETRIES=6
GROQ_API_KEY=
# Only needed for the matching provider:
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Observability (Phase 13) ---
LOG_FORMAT=json
LOG_LEVEL=INFO
# One row per /query request in Postgres (GET /stats reads it); question text is never stored.
REQUEST_LOG_ENABLED=true
# Cost reporting: paid list prices per 1M tokens; *_FREE_TIER=true means billed = 0.
LLM_PRICE_INPUT_PER_M=0.80
LLM_PRICE_OUTPUT_PER_M=4.00
LLM_FREE_TIER=true
